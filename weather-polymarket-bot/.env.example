# weather-polymarket-bot — example configuration
#
# Copy to `.env` and edit as needed. Every value below is optional except
# NWS_USER_AGENT, which NOAA requires you to set to a real contact string.
#
# v1 is paper trading only. Do NOT add a private key here. The bot does not
# read one. Live trading variables are listed at the bottom for v2 planning
# and are intentionally unused.

# ---- NOAA / NWS ----
# Required by NOAA. Format: "app-name (contact-email-or-url)".
NWS_USER_AGENT=weather-polymarket-bot (your-email@example.com)

# ---- Polymarket public endpoints ----
GAMMA_API_BASE=https://gamma-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com

# ---- Scanner ----
# Comma-separated city slugs. Supported in v1: new_york, chicago
CITIES=new_york,chicago

# How often to rescan when --loop is set (seconds)
POLL_INTERVAL_SEC=300

# Max number of markets to pull from Gamma per scan
GAMMA_PAGE_LIMIT=500

# ---- Signal engine ----
# Minimum edge (true_prob - market_yes_price) required to fire a signal
MIN_EDGE=0.05

# Standard deviation of forecast-high error in degrees F.
# 2.5 is reasonable for a 1-day horizon. Increase for further-out dates.
FORECAST_TEMP_STDDEV_F=2.5

# Reject any book whose ask - bid spread exceeds this (in probability units).
MAX_SPREAD=0.05

# Reject any market priced below this (degenerate, no liquidity to bet against).
MIN_YES_PRICE=0.02
# Reject any market priced above this (degenerate, no upside).
MAX_YES_PRICE=0.98

# ---- Risk controls ----
# Simulated dollar size per signal. Used for CSV logging only.
MAX_POSITION_USD=25.0

# Hard cap on signals per UTC day.
MAX_DAILY_SIGNALS=20

# Reject markets whose close time is further than this many days away.
# (Forecast accuracy drops off, NWS forecast only covers ~7 days.)
MAX_FORECAST_HORIZON_DAYS=6

# ---- Output ----
PAPER_TRADES_CSV=logs/paper_trades.csv
LOG_LEVEL=INFO

# ---- v2 (NOT USED in v1) ----
# These are placeholders for the future authenticated CLOB trading path.
# v1 does not read them. Do not put real values here yet.
# POLY_PRIVATE_KEY=
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
